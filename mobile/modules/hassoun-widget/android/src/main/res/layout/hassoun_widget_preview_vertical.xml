<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center_horizontal"
  android:padding="14dp"
  android:background="@drawable/hassoun_widget_bg_ivory">

  <ImageView
    android:layout_width="42dp"
    android:layout_height="42dp"
    android:src="@drawable/hassoun_widget_logo"
    android:contentDescription="Hassoun" />

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:text="HASSOUN"
    android:textColor="#184A3C"
    android:textStyle="bold"
    android:textSize="15sp" />

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="PRAYER TIMES • WINDSOR"
    android:textColor="#9A6F3C"
    android:textSize="8sp" />

  <Space
    android:layout_width="1dp"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:text="NEXT PRAYER"
    android:textColor="#B78B45"
    android:textStyle="bold"
    android:textSize="10sp" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:text="--:--"
    android:textColor="#184A3C"
    android:textStyle="bold"
    android:textSize="28sp" />

  <Space
    android:layout_width="1dp"
    android:layout_height="0dp"
    android:layout_weight="1" />
</LinearLayout>
