<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <UserConfigurations>
        <ColorConfiguration id="themeColor" displayName="color_label" defaultValue="0">
            <ColorOption id="0" displayName="color_green" colors="#55E86E" />
            <ColorOption id="1" displayName="color_white" colors="#FFFFFF" />
            <ColorOption id="2" displayName="color_blue" colors="#42A5FF" />
            <ColorOption id="3" displayName="color_teal" colors="#36D8C4" />
            <ColorOption id="4" displayName="color_purple" colors="#B991FF" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene>
        <!-- Minimal black face with a clean customizable perimeter. -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Ellipse x="0" y="0" width="450" height="450">
                <Fill color="#020706" />
            </Ellipse>
            <Ellipse x="13" y="13" width="424" height="424">
                <Stroke color="[CONFIGURATION.themeColor]" thickness="5" />
            </Ellipse>
            <Ellipse x="24" y="24" width="402" height="402">
                <Stroke color="[CONFIGURATION.themeColor]" thickness="1" />
            </Ellipse>
        </PartDraw>

        <!-- Only useful edge information: steps on the left, battery on the right. -->
        <PartText x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <TextCircular centerX="225" centerY="225" width="406" height="406" startAngle="300" endAngle="338" align="CENTER" direction="CLOCKWISE">
                <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="[CONFIGURATION.themeColor]">
                    <Template><![CDATA[STEPS %d]]><Parameter expression="[STEP_COUNT]" /></Template>
                </Font>
            </TextCircular>
        </PartText>

        <PartText x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <TextCircular centerX="225" centerY="225" width="406" height="406" startAngle="22" endAngle="60" align="CENTER" direction="CLOCKWISE">
                <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="[CONFIGURATION.themeColor]">
                    <Template><![CDATA[BAT %d%%]]><Parameter expression="[BATTERY_PERCENT]" /></Template>
                </Font>
            </TextCircular>
        </PartText>

        <!-- Gregorian date only. -->
        <PartText x="115" y="54" width="220" height="28">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="17" weight="NORMAL" color="#FFFFFF">
                    <Template><![CDATA[%s, %s %d]]>
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                        <Parameter expression="[MONTH_S]" />
                        <Parameter expression="[DAY]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- Large blue time with breathing room. -->
        <DigitalClock x="75" y="88" width="300" height="92">
            <TimeText x="0" y="0" width="300" height="92" format="h:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="78" weight="BOLD" color="#159BFF" />
            </TimeText>
        </DigitalClock>

        <!-- Calories tucked into the right side without a card. -->
        <PartText x="345" y="164" width="70" height="18">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="11" weight="BOLD" color="[CONFIGURATION.themeColor]"><![CDATA[CAL]]></Font>
            </Text>
        </PartText>

        <ComplicationSlot
            slotId="101"
            displayName="@string/calories_slot"
            supportedTypes="SHORT_TEXT EMPTY"
            x="336" y="180" width="88" height="38">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <BoundingOval x="0" y="0" width="88" height="38" />
            <DefaultProviderPolicy
                primaryProvider="ca.hassoun.wear.data/ca.hassoun.wear.data.CaloriesComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="88" height="38">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#FFFFFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <!-- Thin separator instead of a large prayer card. -->
        <PartDraw x="125" y="198" width="200" height="2">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="200" height="2" cornerRadius="1">
                <Fill color="[CONFIGURATION.themeColor]" />
            </RoundRectangle>
        </PartDraw>

        <PartText x="125" y="208" width="200" height="22">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="[CONFIGURATION.themeColor]"><![CDATA[NEXT PRAYER]]></Font>
            </Text>
        </PartText>

        <ComplicationSlot
            slotId="103"
            displayName="@string/next_prayer_slot"
            supportedTypes="SHORT_TEXT EMPTY"
            x="130" y="230" width="190" height="42">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <BoundingOval x="0" y="0" width="190" height="42" />
            <DefaultProviderPolicy
                primaryProvider="ca.hassoun.wear.data/ca.hassoun.wear.data.NextPrayerNameComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="190" height="42">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#FFFFFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot
            slotId="104"
            displayName="@string/prayer_countdown_slot"
            supportedTypes="SHORT_TEXT EMPTY"
            x="130" y="270" width="190" height="40">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <BoundingOval x="0" y="0" width="190" height="40" />
            <DefaultProviderPolicy
                primaryProvider="ca.hassoun.wear.data/ca.hassoun.wear.data.NextPrayerCountdownComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="190" height="40">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="27" weight="BOLD" color="#FFFFFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <PartText x="145" y="307" width="160" height="18">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="11" weight="BOLD" color="[CONFIGURATION.themeColor]"><![CDATA[TIME LEFT]]></Font>
            </Text>
        </PartText>

        <PartDraw x="125" y="329" width="200" height="2">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="200" height="2" cornerRadius="1">
                <Fill color="[CONFIGURATION.themeColor]" />
            </RoundRectangle>
        </PartDraw>

        <!-- Compact, obvious Qibla button. The complication tap opens live compass mode. -->
        <PartDraw x="145" y="345" width="160" height="58">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="160" height="58" cornerRadius="29">
                <Stroke color="[CONFIGURATION.themeColor]" thickness="2" />
            </RoundRectangle>
        </PartDraw>

        <PartText x="160" y="350" width="130" height="18">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="11" weight="BOLD" color="[CONFIGURATION.themeColor]"><![CDATA[QIBLA • TAP]]></Font>
            </Text>
        </PartText>

        <ComplicationSlot
            slotId="102"
            displayName="@string/qibla_slot"
            supportedTypes="SHORT_TEXT EMPTY"
            x="150" y="364" width="150" height="34">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <BoundingOval x="0" y="0" width="150" height="34" />
            <DefaultProviderPolicy
                primaryProvider="ca.hassoun.wear.data/ca.hassoun.wear.data.QiblaComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="150" height="34">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="24" weight="BOLD" color="#FFFFFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
