{
  "authoritative_branch": "main",
  "start_file": "HASSOUN_CURRENT.md",
  "shared_android_apk": {
    "platforms": ["android_phone", "tablet", "tv"],
    "source_root": "mobile/",
    "canonical_workflow": ".github/workflows/tablet-build.yml",
    "generated_apk_path": "mobile/android/app/build/outputs/apk/release/",
    "note": "Android phone, tablet/display mode, and TV/Masjid TV currently ship from the same Android APK. Changes for any of these must be checked against all three modes before release."
  },
  "platforms": {
    "android_phone": {
      "index": ".github/android-phone/README.md",
      "source": ["mobile/", "mobile/App.tsx", "mobile/src/", "mobile/modules/"],
      "shared_apk_group": "android_phone+tablet+tv"
    },
    "tablet": {
      "index": ".github/tablet/README.md",
      "source": ["mobile/src/MasjidDisplayPage.tsx", "mobile/src/ConnectDisplayPage.tsx"],
      "shared_apk_group": "android_phone+tablet+tv"
    },
    "tv": {
      "index": ".github/tv/README.md",
      "source": ["mobile/src/MasjidDisplayPage.tsx", "mobile/src/ConnectDisplayPage.tsx", "mobile/scripts/apply-masjid-tv.mjs", "mobile/scripts/apply-masjid-tv-fixes.mjs"],
      "shared_apk_group": "android_phone+tablet+tv",
      "note": "TV is a mode inside the same Android APK, not a separate APK."
    },
    "watch": {
      "index": ".github/watch/README.md",
      "source": ["wearos/", "wearos/watchface/", "wearos/datasource/"],
      "workflow": ".github/workflows/wearos-build.yml",
      "note": "Wear OS is a separate native build."
    },
    "ios": {
      "index": ".github/ios/README.md",
      "source": ["mobile/", "mobile/app.config.ts", "mobile/eas.json"],
      "workflows": [".github/workflows/ios-testflight.yml", ".github/workflows/ios-submit-latest.yml", ".github/workflows/validate-ios-quran-audio.yml"],
      "note": "iOS shares Expo source with mobile but is a separate Apple build. Native ios/ is generated when required."
    },
    "web": {
      "index": ".github/web/README.md",
      "domain": "hassou.app",
      "source": ["pwa/", "pwa/app/", "pwa/public/"],
      "workflows": [".github/workflows/pwa-ci.yml", ".github/workflows/deploy-pages.yml"],
      "note": "Web/PWA is a separate build and deployment from the Android APK."
    }
  }
}
