{
  "authoritative_branch": "main",
  "start_file": "HASSOUN_CURRENT.md",
  "platforms": {
    "tablet": {
      "index": ".github/tablet/README.md",
      "source": ["mobile/src/MasjidDisplayPage.tsx", "mobile/src/ConnectDisplayPage.tsx"],
      "workflow": ".github/workflows/tablet-build.yml"
    },
    "tv": {
      "index": ".github/tv/README.md",
      "source": ["mobile/src/MasjidDisplayPage.tsx", "mobile/src/ConnectDisplayPage.tsx", "mobile/scripts/apply-masjid-tv.mjs", "mobile/scripts/apply-masjid-tv-fixes.mjs"],
      "workflow": ".github/workflows/tablet-build.yml",
      "note": "TV is currently integrated into the shared mobile/display codebase rather than a separate app."
    },
    "watch": {
      "index": ".github/watch/README.md",
      "source": ["wearos/", "wearos/watchface/", "wearos/datasource/"],
      "workflow": ".github/workflows/wearos-build.yml"
    },
    "ios": {
      "index": ".github/ios/README.md",
      "source": ["mobile/", "mobile/app.config.ts", "mobile/eas.json"],
      "workflows": [".github/workflows/ios-testflight.yml", ".github/workflows/ios-submit-latest.yml", ".github/workflows/validate-ios-quran-audio.yml"],
      "note": "Native ios/ is generated by Expo/EAS when needed and is not currently committed on main."
    },
    "android_phone": {
      "index": ".github/android-phone/README.md",
      "source": ["mobile/", "mobile/App.tsx", "mobile/src/", "mobile/modules/"],
      "workflows": [".github/workflows/android-debug.yml", ".github/workflows/android-play-submit.yml"]
    }
  }
}
