{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wopt-prayer-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wopt-prayer-push",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SCHEDULE_URL": "https://raw.githubusercontent.com/Hassoun911/WOPT/main/windsor_islamic_association_2026_prayer_times.json",
    "ALLOWED_WEB_ORIGIN": "https://hassoun911.github.io"
  }
}
